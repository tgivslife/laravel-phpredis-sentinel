{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tgivslife/laravel-phpredis-sentinel",
    "description": "Redis Sentinel support for Laravel using the PhpRedis extension.",
    "keywords": [
        "laravel",
        "redis",
        "sentinel",
        "phpredis",
        "horizon"
    ],
    "homepage": "https://github.com/tgivslife/laravel-phpredis-sentinel",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/tgivslife/laravel-phpredis-sentinel/issues",
        "source": "https://github.com/tgivslife/laravel-phpredis-sentinel"
    },
    "authors": [
        {
            "name": "Teodor Ion",
            "email": "teodor.g.ion@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-redis": "^6.3",
        "illuminate/redis": "^13.33",
        "illuminate/support": "^13.33",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/horizon": "^5.48",
        "laravel/pint": "1.32.1",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5|^13.0"
    },
    "suggest": {
        "laravel/horizon": "Supported for queue processing and Horizon metadata over Sentinel connections."
    },
    "autoload": {
        "psr-4": {
            "Tgi\\LaravelPhpRedisSentinel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tgi\\LaravelPhpRedisSentinel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "@php vendor/bin/pint",
        "lint:check": "@php vendor/bin/pint --test",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=-1",
        "test:unit": "@php vendor/bin/phpunit --testsuite=Unit",
        "test:feature": "@php vendor/bin/phpunit --testsuite=Feature",
        "test": [
            "@composer validate --strict",
            "@lint:check",
            "@analyse",
            "@php vendor/bin/phpunit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tgi\\LaravelPhpRedisSentinel\\RedisSentinelServiceProvider"
            ]
        }
    },
    "config": {
        "platform": {
            "ext-pcntl": "8.3.0",
            "ext-posix": "8.3.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
